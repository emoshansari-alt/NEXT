# Normalise line endings in the repository to LF.
#
# This matters concretely: scripts/lint-nextkit.sh runs on an Ubuntu CI runner, and a CRLF
# shebang line fails there with "bad interpreter". Development happens on Windows, so
# without this the working copy would push CRLF and break CI.

* text=auto eol=lf

# PowerShell is Windows-native; keep CRLF so it behaves in every Windows host.
*.ps1 text eol=crlf

# Must be LF — executed by bash and by GitHub Actions.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.swift    text eol=lf
*.md       text eol=lf
*.json     text eol=lf
*.storekit text eol=lf

# Binary assets — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.ico  binary
*.icns binary
